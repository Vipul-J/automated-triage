# --- Claude ---------------------------------------------------------------
# Leave ANTHROPIC_API_KEY unset to run the whole pipeline against a deterministic
# mock model. Set it to use the real Claude API.
# ANTHROPIC_API_KEY=sk-ant-...
TRIAGE_MODEL=claude-opus-5
# low | medium | high | xhigh | max  - "low"/"medium" keep us inside the latency budget
TRIAGE_EFFORT=medium

# --- Database -------------------------------------------------------------
DATABASE_URL=postgres://triage:triage@localhost:5433/triage

# --- Ports ----------------------------------------------------------------
TRIAGE_PORT=3000
SIM_PORT=4000
SIM_BASE_URL=http://localhost:4000
TRIAGE_BASE_URL=http://localhost:3000

# --- Deadlines (ms) -------------------------------------------------------
# Real escalation window is 180000 (3 min). Lower it to watch the timer fire fast.
ESCALATION_WINDOW_MS=180000
# Auto-commit fires this long BEFORE escalation (design doc: T+150s of 180s)
AUTOCOMMIT_MARGIN_MS=30000

# --- Policy thresholds (design doc section 10) ----------------------------
CONF_AUTO=0.85
CONF_REVIEW=0.60
# Downward routes to L1 need a higher bar (design doc section 10.1)
CONF_DOWNWARD_L1=0.90

WEBHOOK_SECRET=dev-shared-secret
