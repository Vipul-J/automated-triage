{
  "name": "automated-triage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-assisted support ticket triage - walking skeleton",
  "scripts": {
    "dev": "concurrently -n sim,triage -c cyan,green \"npm:sim\" \"npm:start\"",
    "start": "tsx src/main.ts",
    "sim": "tsx tools/simulator/server.ts",
    "db:up": "docker compose up -d && node tools/wait-for-db.mjs",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && npm run db:up && npm run seed",
    "migrate": "tsx src/platform/db/migrate.ts",
    "seed": "tsx tools/seed.ts",
    "demo": "tsx tools/demo.ts",
    "probe": "tsx tools/probe-retrieval.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "concurrently": "^9.1.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0"
  }
}
